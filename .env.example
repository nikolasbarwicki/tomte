# Every environment variable the Tomte host reads. All are optional; the defaults suit `bun run dev`.
# Bun loads `.env` from the working directory, so `cp .env.example .env` and uncomment what you need.
# A command-line flag (`--data-root`, `--port`, …) beats its variable. Never put a real token in this file.

# --- Host (packages/host/src/platform/config.ts) ---

# `local` (default; desktop and your own machine) or `remote` (a Linux server, ADR-0006).
# TOMTE_MODE=local

# Absolute folder for all host state: database, bots, workspace, managed Claude CLI and browser.
# Default: ~/Library/Application Support/tomte (macOS), $XDG_DATA_HOME/tomte or ~/.local/share/tomte (Linux), %APPDATA%\tomte (Windows).
# TOMTE_DATA_ROOT=/tmp/tomte-dev/data

# Address and port of the client listener. Default 127.0.0.1 and a free port (`bun run dev` passes 5173).
# A non-loopback address needs an https TOMTE_PUBLIC_URL or TOMTE_ALLOW_PLAIN_HTTP.
# TOMTE_HOST=127.0.0.1
# TOMTE_PORT=5173

# The origin users and OAuth providers reach, when it is not the loopback URL (a TLS proxy in front).
# TOMTE_PUBLIC_URL=https://tomte.example.com

# Allow a non-loopback bind over plain http, on a private network such as Tailscale only. 1/0, true/false.
# TOMTE_ALLOW_PLAIN_HTTP=0

# Secrets backend: `keychain` (default in local mode) or `file` (default in remote mode).
# The file backend needs an absolute key file of 32 random bytes: head -c 32 /dev/urandom > key
# TOMTE_SECRETS=file
# TOMTE_SECRETS_KEY_FILE=/tmp/tomte-dev/key

# Relay configuration (ADR-0008, docs/relay.md). Default: relay.json in the data root; it need not exist.
# TOMTE_RELAY_CONFIG=/absolute/path/relay.json

# Pause every active routine after this many days without any action from you. 0 is off.
# TOMTE_PAUSE_AFTER_ABSENCE_DAYS=0

# Ask before a bot runs a tool instead of approving everything. 1/0, true/false.
# TOMTE_ASK_APPROVAL=0

# Serve the web UI through Vite. `bun run dev` already passes --vite.
# TOMTE_VITE=0

# --- Claude CLI (packages/host/src/harness) ---

# The Claude Code CLI to run. Default: the managed copy in the data root (`bun run host install-cli`), then `claude` on PATH.
# CLAUDE_PATH=/absolute/path/to/claude

# The CLI's own config folder (sign-in). Default ~/.claude; in remote mode the host sets it to claude/ in the data root.
# CLAUDE_CONFIG_DIR=/absolute/path/.claude

# --- Developing without a Claude subscription (CONTRIBUTING.md) ---
# The test suite's fake CLI answers every message with "ok" and needs a folder to keep its files in.
# CLAUDE_PATH=/absolute/path/to/tomte/packages/host/src/testing/fake-claude.ts
# FAKE_CLAUDE_DIR=/tmp/tomte-dev/fake

# --- Browser (packages/host/src/browser) ---

# The agent-browser engine binary. Default: the bundled copy, then the managed install (`bun run host install-browser`), then PATH.
# AGENT_BROWSER_PATH=/absolute/path/agent-browser
# The Chrome binary the engine drives. Default: the engine's own Chrome.
# AGENT_BROWSER_EXECUTABLE_PATH=/absolute/path/chrome

# --- Smokes (docs/smoke.md) ---

# Chrome for the browser smokes. Default: /Applications/Google Chrome.app on macOS.
# CHROME_PATH=/usr/bin/google-chrome
