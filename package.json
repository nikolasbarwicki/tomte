{
  "name": "claudebot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "host": "bun packages/host/src/host.ts",
    "ui": "bun packages/host/src/server.ts",
    "dev": "bun --watch packages/host/src/server.ts --port 5173 --vite",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun test",
    "depcheck": "depcruise packages",
    "check": "bun run typecheck && bun run depcheck && bun test"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "dependency-cruiser": "^18.7.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
