{
  "name": "claudebot",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "host": "bun packages/host/src/host.ts",
    "ui": "bun packages/host/src/server.ts",
    "dev": "bun --watch packages/host/src/server.ts --port 5173 --vite",
    "build:web": "bun --filter @claudebot/web build",
    "build:host": "bun scripts/build-host.ts",
    "smoke:host": "bun scripts/smoke-host.ts",
    "smoke:answer-ui": "bun scripts/smoke-answer-ui.ts",
    "smoke:needs-you-ui": "bun scripts/smoke-needs-you-ui.ts",
    "smoke:blocked-ui": "bun scripts/smoke-blocked-ui.ts",
    "smoke:answers": "bun scripts/smoke-answers.ts",
    "smoke:ui": "bun scripts/smoke-ui.ts",
    "eval:loop-routing": "bun scripts/eval-loop-routing.ts",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun test && bun scripts/check-coverage.ts",
    "depcheck": "depcruise packages",
    "check": "bun run fmt:check && bun run lint && bun run knip && bun run typecheck && bun run depcheck && bun run test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "knip": "knip",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "build:desktop": "bun scripts/build-desktop.ts",
    "package:desktop": "bun scripts/package-desktop.ts",
    "icons:desktop": "bun scripts/make-tray-icons.ts",
    "smoke:desktop": "bun scripts/smoke-desktop.ts",
    "smoke:desktop:profiles": "bun scripts/smoke-desktop-profiles.ts",
    "smoke:desktop:titlebar": "bun scripts/smoke-desktop-titlebar.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@electron/packager": "^20.3.0",
    "@swc/core": "^1.16.22",
    "dependency-cruiser": "^18.7.2",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
