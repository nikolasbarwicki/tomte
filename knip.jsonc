{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // @swc/core: dependency-cruiser loads it by name via `parser: "swc"` in .dependency-cruiser.cjs.
      "ignoreDependencies": ["@swc/core"],
    },
    "packages/host": {
      "entry": [
        // Compiled by scripts/build-host.ts; main.ts loads the other two by dynamic import.
        "src/main.ts",
        "src/host.ts",
        "src/server.ts",
        // Spawned as subprocesses by tests via path strings (fake Claude, MCP stdio server, lock holder, fake agent-browser).
        "src/testing/*.ts",
      ],
      "project": ["src/**/*.ts"],
    },
    "packages/web": {
      "vite": { "config": ["vite.config.ts"] },
      // Linked from index.html (/tailwind.css), which knip doesn't follow for stylesheets; the plugin config makes it an entry.
      "tailwind": { "config": ["tailwind.css"] },
      "project": ["**/*.{ts,tsx,css}"],
    },
    "packages/desktop": {
      // Bundled to dist/main.cjs by scripts/build-desktop.ts and run by Electron, never imported.
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"],
    },
    "packages/notify": {
      // The `tomte-notify` bin, run by path or symlink and never imported.
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"],
    },
    "packages/contract": {
      "project": ["src/**/*.ts"],
    },
  },
  "ignoreIssues": {
    // components/ui is vendored shadcn: files keep every export the registry ships so later `shadcn add` diffs stay clean.
    "packages/web/components/ui/**": ["exports", "types"],
  },
}
