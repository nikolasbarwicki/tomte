# TOMTE_PUBLIC_URL in /etc/tomte/tomte.env must be exactly https://tomte.example.com.
# The host answers 403 to any other Host header, so do not rewrite it, and it ignores X-Forwarded-*.
# The event stream and live view are text/event-stream, which Caddy flushes immediately: no flush_interval.
tomte.example.com {
	reverse_proxy 127.0.0.1:8417
}
